# Copy this file to .env. Never commit real credentials.
#
# This three-variable interface is used by the teacher pipelines.  Phase 2C
# sends the chart image, so the endpoint/model configured here MUST support
# OpenAI-compatible `image_url` content.  The official DeepSeek chat endpoint
# provides JSON mode but is text-only; do not use it for bbox/visual labels.
# If DeepSeek is used through a gateway, use that gateway's vision-capable model.
TEACHER_API_KEY=
TEACHER_BASE_URL=
TEACHER_MODEL=

# Optional Phase 2C overrides. Leave blank to reuse TEACHER_* above.
# Values: gemini | openai_compatible. DeepSeek-compatible gateways use
# openai_compatible; direct DeepSeek should not be used for visual grounding.
VISUAL_TEACHER_PROVIDER=openai_compatible
VISUAL_TEACHER_API_KEY=
VISUAL_TEACHER_BASE_URL=
VISUAL_TEACHER_MODEL=
VISUAL_TEACHER_LIMIT=100
VISUAL_TEACHER_MIN_CONFIDENCE=0.80
# Maximum total attempts per image. Keep this low for a pilot so one stalled
# provider request becomes TEACHER_ERROR instead of blocking the whole queue.
VISUAL_TEACHER_MAX_ATTEMPTS=2
